# Project Configuration
PROJECT_NAME="University Scientific Association API"
PROJECT_VERSION="0.1.0"

# API URL prefix
API_V1_STR="/api/v1"

# Security settings - IMPORTANT: Change SECRET_KEY in your actual .env file!
# Generate a good one with: openssl rand -hex 32
SECRET_KEY="YOUR_VERY_SECRET_KEY_HERE_PLEASE_CHANGE_ME"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database settings (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="your_db_password"
POSTGRES_DB="university_association_db"

# CORS Origins (comma-separated list of URLs)
# Example: BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://your.frontend.domain"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Email settings
# SMTP_HOST="smtp.example.ir"
# SMTP_PORT=587
# SMTP_USER="your_email_user"
# SMTP_PASSWORD="your_email_password"
# EMAILS_FROM_EMAIL="noreply@your-association.ir"
# EMAILS_FROM_NAME="Scientific Association"

# SMS settings (e.g., Kavenegar)
# SMS_API_KEY="YOUR_KAVENEGAR_API_KEY"
# SMS_SENDER_NUMBER="YOUR_SENDER_NUMBER"

# Redis settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
